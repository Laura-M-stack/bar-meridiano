---
import Base from '../layouts/Base.astro';
import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Carta from '../components/Carta.astro';
import Ambiente from '../components/Ambiente.astro';
import Eventos from '../components/Eventos.astro';
import Reservas from '../components/Reservas.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base
  title={`${site.name} · ${site.kind} en Palermo`}
  description="Coctelería de autor en Palermo, Buenos Aires: clásicos bien hechos, cócteles propios, música en vivo y reservas por WhatsApp. Sitio de demostración."
>
  <DemoBanner />
  <Header />
  <main id="contenido">
    <Hero />
    <Carta />
    <Ambiente />
    <Eventos />
    <Reservas />
  </main>
  <Footer />
</Base>
